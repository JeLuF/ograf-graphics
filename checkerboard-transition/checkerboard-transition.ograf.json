{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "mov.ograf.logo-tile-transition",
  "version": "1.3.1",
  "name": "Checkerboard Transition",
  "description": "Playful full-screen scene transition with an SVG logo (zero-step graphic, played once): a wave of rounded red tiles shaped like the logo pops in from the screen centre while the logo drops in with a somersault and bounces; it sways while the screen is covered, then leaps out with a backflip and the tiles shrink away. Play runs the whole sequence once and the graphic animates out by itself; Stop is optional and ends the hold early.",
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 0,
  "thumbnails": [
    {
      "file": "thumbs/checker-still.webp",
      "resolution": {
        "width": 1280,
        "height": 720
      }
    },
    {
      "file": "thumbs/checkerboard.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],

  "schema": {
    "type": "object",
    "properties": {
      "logo": {
        "type": "string",
        "title": "Logo",
        "default": "./assets/logo.svg",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "jpg",
            "png",
            "jpeg",
            "webp",
            "gif",
            "svg"
          ]
        },
        "order": 0
      },
      "tileColor1": {
        "type": "string",
        "title": "Checkerboard colour 1",
        "default": "#c8121f",
        "order": 4,
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "tileColor2": {
        "type": "string",
        "title": "Checkerboard colour 2",
        "default": "#b00f1b",
        "order": 5,
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "hueRampX": {
        "type": "number",
        "title": "Horizontal hue ramp: hue shift in degrees from left to right edge (0 = off)",
        "default": 0,
        "minimum": -360,
        "maximum": 360,
        "order": 6
      },
      "hueRampY": {
        "type": "number",
        "title": "Vertical hue ramp: hue shift in degrees from top to bottom edge (0 = off)",
        "default": 0,
        "minimum": -360,
        "maximum": 360,
        "order": 7
      },
      "holdSeconds": {
        "type": "number",
        "title": "Hold: seconds the logo stays after landing (screen fully covered)",
        "default": 1.5,
        "minimum": 0,
        "maximum": 60,
        "order": 1
      },
      "tileColumns": {
        "type": "integer",
        "title": "Tile columns (3-20; more columns = smaller tiles)",
        "default": 8,
        "minimum": 3,
        "maximum": 20,
        "order": 2
      },
      "heightPercent": {
        "type": "number",
        "title": "Logo height in % of screen height",
        "default": 70,
        "minimum": 20,
        "maximum": 100,
        "order": 3
      }
    }
  }
}
