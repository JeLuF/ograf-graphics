{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "wheel-of-fortune",
  "version": "1.4.0",
  "name": "Wheel of Fortune",
  "description": "Wheel of fortune with any number of outcomes (array input of count and label, colours from a selectable theme). Segment size is proportional to the count, so the chance of winning equals the share. Includes a colour legend and shows the winner after the spin. Play shows the wheel, the next step (or the Spin action) spins it, Stop hides it. Optional distributed layout: equal-sized areas, repeated by share count and spread around the wheel.",
  "author": {
    "name": "DTB"
  },
  "main": "graphic.mjs",
  "thumbnails": [
    {
      "file": "thumbs/wheel-of-fortune.jpg",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 2,
  "schema": {
    "type": "object",
    "properties": {
      "logo": {
        "type": "string",
        "title": "Logo",
        "default": "./assets/logo.svg",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "jpg",
            "png",
            "jpeg",
            "webp",
            "gif",
            "svg"
          ]
        },
        "order": 0
      },
      "title": {
        "type": "string",
        "title": "Title",
        "default": "Wheel of Fortune",
        "order": 1
      },
      "position": {
        "type": "string",
        "title": "Position",
        "enum": [
          "left",
          "center",
          "right"
        ],
        "gddType": "select",
        "gddOptions": {
          "labels": {
            "left": "Left",
            "center": "Center",
            "right": "Right"
          }
        },
        "default": "right",
        "order": 2,
        "hidden": true
      },
      "layout": {
        "type": "string",
        "title": "Wheel layout (proportional / distributed)",
        "description": "proportional: area size follows the share count. distributed: all areas are equally sized and each outcome gets as many areas as its count, spread around the wheel with no equal colours side by side where possible.",
        "enum": [
          "proportional",
          "distributed"
        ],
        "gddType": "select",
        "default": "proportional",
        "hidden": true,
        "order": 3
      },
      "spinDuration": {
        "type": "string",
        "title": "Spin duration in seconds",
        "default": "6",
        "hidden": true,
        "order": 4
      },
      "outcomes": {
        "type": "array",
        "title": "Outcomes",
        "description": "Segment size is proportional to the count; colours come from the visual theme. Entries with an empty label or a count below 1 are ignored.",
        "default": [
          {
            "count": 1,
            "label": "Top prize"
          },
          {
            "count": 3,
            "label": "Fan package"
          },
          {
            "count": 4,
            "label": "Free drink"
          },
          {
            "count": 2,
            "label": "Free ticket"
          },
          {
            "count": 5,
            "label": "Small prize"
          }
        ],
        "items": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "title": "Count",
              "default": 1,
              "minimum": 1
            },
            "label": {
              "type": "string",
              "title": "Label",
              "default": ""
            }
          }
        },
        "order": 5
      },
      "backgroundColor": {
        "type": "string",
        "title": "Background colour",
        "order": 6,
        "default": "#ffffffff",
        "gddType": "color-rrggbbaa",
        "pattern": "^#[0-9a-f]{8}$"
      },
      "textColor": {
        "type": "string",
        "title": "Text colour",
        "order": 7,
        "default": "#000000",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "accentColor": {
        "type": "string",
        "title": "Accent colour",
        "order": 8,
        "default": "#e30613",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "theme": {
        "v_spx": {
          "ftype": "filelist",
          "assetfolder": "./assets/",
          "extension": "css"
        },
        "type": "string",
        "title": "Visual Theme",
        "default": "./assets/rainbow.css",
        "order": 9
      }
    }
  },
  "customActions": [
    {
      "id": "spin",
      "name": "Spin",
      "description": "Spin the wheel (shows it first if it is hidden). Can be used repeatedly."
    }
  ]
}
