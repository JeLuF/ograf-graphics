{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "countdown",
  "version": "1.1.0",
  "name": "Countdown",
  "description": "Card with a live countdown (duration in minutes or target clock time). White card, black text, logo, corner of choice (top/bottom, left/right). Play starts the countdown, Stop hides it.",
  "author": {
    "name": "Emisora"
  },
  "main": "countdown.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title",
        "default": "Warmup"
      },
      "subtitle": {
        "type": "string",
        "title": "Subtitle",
        "default": "Group 1"
      },
      "position": {
        "type": "string",
        "title": "Position",
	"gddType": "select",
        "enum": [
          "top-left",
          "bottom-left",
          "top-right",
          "bottom-right"
        ],
        "default": "top-left",
	"gddOptions": {
	    "labels": {
	        "top-left":     "Top left",
	        "top-right":    "Top right",
	        "bottom-left":  "Bottom left",
	        "bottom-right": "Bottom right"
            }
	}
      },
      "duration": {
        "type": "string",
        "title": "Duration in minutes (counted from Play)",
        "default": "15"
      },
      "endTime": {
        "type": "string",
        "title": "Optional: end at clock time (H:MM or HH:MM)",
        "description": "If set, the countdown runs to this time of day (local time of the playout machine) instead of using the duration.",
        "default": ""
      },
      "finishedText": {
        "type": "string",
        "title": "Text when countdown reaches zero",
        "default": "Continuing soon!"
      }
    }
  },
  "customActions": [
    {
      "id": "restart",
      "name": "Restart countdown",
      "description": "Restart the countdown from the full duration (or the end time)."
    }
  ]
}
