{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "schedule2",
  "version": "1.6.0",
  "name": "Schedule Panel (2 Tracks)",
  "description": "Upcoming schedule with two parallel tracks. array input (time, event1, subline1, event2, subline2), the first 8 non-empty entries are shown, evenly distributed vertically. White panel, black text, logo. A footer text area at the bottom is configurable. Slides in from the right, one third of the screen width. A delay field (minutes, may be negative) is added to every displayed time.",
  "author": {
    "name": "Emisora"
  },
  "thumbnails": [
    {
      "file": "thumbs/schedule.jpg",
      "resolution": {
        "width": 640,
        "height": 360
      }
    },
    {
      "file": "thumbs/schedule.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "logo": {
        "type": "string",
        "title": "Logo",
        "default": "./assets/logo.svg",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "jpg",
            "png",
            "jpeg",
            "webp",
            "gif",
            "svg"
          ]
        },
        "order": 0
      },
      "delay": {
        "type": "string",
        "title": "Delay in minutes (negative = ahead of schedule)",
        "default": "0",
        "order": 1,
        "hidden": true
      },
      "title": {
        "type": "string",
        "title": "Title",
        "default": "Coming up",
        "order": 2
      },
      "leftHeader": {
        "type": "string",
        "title": "Left column heading",
        "default": "Left",
        "order": 3
      },
      "rightHeader": {
        "type": "string",
        "title": "Right column heading",
        "default": "Right",
        "order": 4
      },
      "footer": {
        "type": "string",
        "title": "Footer text (bottom of panel)",
        "default": "All times are estimates and might change.",
        "order": 5
      },
      "backgroundColor": {
        "type": "string",
        "title": "Background colour",
        "order": 7,
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Text colour",
        "order": 8,
        "default": "#000000",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "accentColor": {
        "type": "string",
        "title": "Accent colour",
        "order": 9,
        "default": "#e30613",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "schedule": {
        "type": "array",
        "title": "Schedule",
        "description": "Empty entries are skipped and only the first 8 non-empty ones are shown.",
        "default": [
          {
            "time": "10:00",
            "event1": "Girls 11/12",
            "subline1": "Quali group 1",
            "event2": "Boys 13/14",
            "subline2": "Quali"
          },
          {
            "time": "10:40",
            "event1": "Girls 11/12",
            "subline1": "Quali group 2",
            "event2": "Boys 11/12",
            "subline2": "Quali"
          },
          {
            "time": "11:20",
            "event1": "Girls 13/14",
            "subline1": "Quali",
            "event2": "Girls 15/16",
            "subline2": "Quali"
          }
        ],
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "title": "Time",
              "default": ""
            },
            "event1": {
              "type": "string",
              "title": "Event 1",
              "default": ""
            },
            "subline1": {
              "type": "string",
              "title": "Subline 1",
              "default": ""
            },
            "event2": {
              "type": "string",
              "title": "Event 2",
              "default": ""
            },
            "subline2": {
              "type": "string",
              "title": "Subline 2",
              "default": ""
            }
          }
        },
        "order": 6
      }
    }
  }
}
