{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "trapezoid",
  "version": "1.3.1",
  "name": "Trapezoid Banner",
  "description": "Single-line trapezoid banner attached to the top edge of the screen (white, black text). Width and height are configurable (in px at 1920 px screen width); the height also scales font size and corner radii. Narrower at the bottom, rounded bottom corners, concave rounded corners that blend the banner into the top edge. Slides in from the top.",
  "author": {
    "name": "Emisora"
  },
  "main": "graphic.mjs",
  "thumbnails": [
    {
      "file": "thumbs/trapezoid.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "title": "Text",
        "default": "Short Break, we'll be back soon!",
        "order": 1
      },
      "width": {
        "type": "string",
        "title": "Width in px",
        "default": "1100",
        "order": 2,
	"hidden": true
      },
      "height": {
        "type": "string",
        "title": "Height in px",
        "default": "70",
        "order": 3,
	"hidden": true
      },
      "backgroundColor": {
        "type": "string",
        "title": "Background colour",
        "order": 4,
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Text colour",
        "order": 5,
        "default": "#000000",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  }
}
