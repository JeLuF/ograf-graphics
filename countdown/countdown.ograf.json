{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "countdown",
  "version": "1.2.0",
  "name": "Countdown",
  "description": "Live countdown (duration in minutes or target clock time). White card, black text, logo, corner of choice (top/bottom, left/right). Play starts the countdown, Stop hides it.",
  "author": {
    "name": "Emisora"
  },
  "main": "graphic.mjs",
  "thumbnails": [
    {
      "file": "thumbs/countdown.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "logo": {
        "type": "string",
        "title": "Logo",
        "default": "./assets/logo.svg",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "jpg",
            "png",
            "jpeg",
            "webp",
            "gif",
            "svg"
          ]
        },
        "order": 0
      },
      "title": {
        "type": "string",
        "title": "Title",
        "default": "Short Break",
        "order": 1
      },
      "subtitle": {
        "type": "string",
        "title": "Subtitle",
        "default": "Preparing lunch",
        "order": 2
      },
      "position": {
        "type": "string",
        "title": "Position",
        "enum": [
          "top-left",
          "bottom-left",
          "top-right",
          "bottom-right"
        ],
        "gddType": "select",
        "gddOptions": {
          "labels": {
            "top-left": "Top Left",
            "bottom-left": "Bottom Left",
            "top-right": "Top Right",
	    "bottom-right": "Bottom Right"
          }
        },
        "default": "top-left",
        "order": 3,
	"hidden": true
      },
      "duration": {
        "type": "string",
        "title": "Duration in minutes (counted from Play)",
        "default": "15",
        "order": 4,
	"hidden": true
      },
      "endTime": {
        "type": "string",
        "title": "Optional: end at clock time (H:MM or HH:MM)",
        "description": "If set, the countdown runs to this time of day (local time of the playout machine) instead of using the duration.",
        "default": "",
        "order": 5,
	"hidden": true
      },
      "finishedText": {
        "type": "string",
        "title": "Text when countdown reaches zero",
        "default": "I'll be right back!",
        "order": 6
      },
      "backgroundColor": {
        "type": "string",
        "title": "Background colour",
        "order": 7,
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Text colour",
        "order": 8,
        "default": "#000000",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "accentColor": {
        "type": "string",
        "title": "Accent colour",
        "order": 9,
        "default": "#e30613",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  },
  "customActions": [
    {
      "id": "restart",
      "name": "Restart countdown",
      "description": "Restart the countdown from the full duration (or the end time)."
    }
  ]
}
