{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dual-lower-third",
  "version": "1.0.1",
  "name": "Dual Lower Third",
  "description": "Two independent white lower-third stickers (left and right) with black text and a logo.",
  "author": {
    "name": "Emisora"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "thumbnails": [
    {
      "file": "thumbs/dual-lower-thirds2.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    },
    {
      "file": "thumbs/dual-lower-thirds.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "show": {
        "type": "string",
        "title": "Show (applies on Play/Update)",
        "enum": [
          "both",
          "left",
          "right"
        ],
        "gddType": "select",
        "gddOptions": {
          "labels": {
            "both": "Show both",
            "left": "Show left",
            "right": "Show right"
          }
        },
        "default": "both",
        "order": 1
      },
      "leftLine1": {
        "type": "string",
        "title": "Left: line 1 (headline)",
        "default": "Left Name",
        "order": 2
      },
      "leftLine2": {
        "type": "string",
        "title": "Left: line 2 (subtitle)",
        "default": "Left Title",
        "order": 3
      },
      "rightLine1": {
        "type": "string",
        "title": "Right: line 1 (headline)",
        "default": "Right Name",
        "order": 4
      },
      "rightLine2": {
        "type": "string",
        "title": "Right: line 2 (subtitle)",
        "default": "Right Title",
        "order": 5
      }
    }
  },
  "customActions": [
    {
      "id": "showLeft",
      "name": "Show left",
      "description": "Show the left lower third (right side unchanged)."
    },
    {
      "id": "showRight",
      "name": "Show right",
      "description": "Show the right lower third (left side unchanged)."
    },
    {
      "id": "showBoth",
      "name": "Show both",
      "description": "Show the left and right lower thirds."
    },
    {
      "id": "hide",
      "name": "Hide",
      "description": "Hide all lower thirds."
    }
  ]
}
