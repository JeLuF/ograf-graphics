{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dual-lower-third",
  "version": "1.3.0",
  "name": "Dual Lower Third",
  "description": "Two independent white lower-third stickers (left and right) with black text and a logo.",
  "author": {
    "name": "Emisora"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "thumbnails": [
    {
      "file": "thumbs/dual-lower-thirds2.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    },
    {
      "file": "thumbs/dual-lower-thirds.webp",
      "resolution": {
        "width": 640,
        "height": 360
      }
    }
  ],
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "logo": {
        "type": "string",
        "title": "Logo",
        "default": "./assets/logo.svg",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "jpg",
            "png",
            "jpeg",
            "webp",
            "gif",
            "svg"
          ]
        },
        "order": 0
      },
      "show": {
        "type": "string",
        "title": "Show (applies on Play/Update)",
        "enum": [
          "both",
          "left",
          "right"
        ],
        "gddType": "select",
        "gddOptions": {
          "labels": {
            "both": "Show both",
            "left": "Show left",
            "right": "Show right"
          }
        },
        "default": "both",
        "order": 1
      },
      "leftLine1": {
        "type": "string",
        "title": "Left: line 1 (headline)",
        "default": "Left Name",
        "order": 2
      },
      "leftLine2": {
        "type": "string",
        "title": "Left: line 2 (subtitle)",
        "default": "Left Title",
        "order": 3
      },
      "rightLine1": {
        "type": "string",
        "title": "Right: line 1 (headline)",
        "default": "Right Name",
        "order": 4
      },
      "rightLine2": {
        "type": "string",
        "title": "Right: line 2 (subtitle)",
        "default": "Right Title",
        "order": 5
      },
      "backgroundColor": {
        "type": "string",
        "title": "Background colour",
        "order": 6,
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Text colour",
        "order": 7,
        "default": "#000000",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "slideInDuration": {
        "type": "number",
        "title": "Slide in duration (seconds)",
        "default": 0.5,
        "minimum": 0,
        "order": 8
      },
      "slideOutDuration": {
        "type": "number",
        "title": "Slide out duration (seconds)",
        "default": 0.5,
        "minimum": 0,
        "order": 9
      }
    }
  },
  "customActions": [
    {
      "id": "showLeft",
      "name": "Show left",
      "description": "Show the left lower third (right side unchanged).",
      "schema": { "type": "object", "properties": {} }
    },
    {
      "id": "showRight",
      "name": "Show right",
      "description": "Show the right lower third (left side unchanged).",
      "schema": { "type": "object", "properties": {} }
    },
    {
      "id": "showBoth",
      "name": "Show both",
      "description": "Show the left and right lower thirds.",
      "schema": { "type": "object", "properties": {} }
    },
    {
      "id": "hide",
      "name": "Hide",
      "description": "Hide all lower thirds.",
      "schema": { "type": "object", "properties": {} }
    }
  ]
}
